# Copy to .env.local and fill in. .env.local is git-ignored.
# Local values come from `supabase status` after `supabase start`.

# --- Supabase (required) ---
# API URL. Local: http://127.0.0.1:54321 | Cloud: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / publishable key (Project Settings -> API, or `supabase status`)
# Used by src/lib/supabase/{client,server,middleware}.ts
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# JWT secret — used by src/lib/get-user-role.ts to verify the access token
# (Project Settings -> API -> JWT Settings, or `supabase status`)
SUPABASE_JWT_SECRET=

# --- Google OAuth ---
# Login "Acessar com Google" (supabase.auth.signInWithOAuth).
# Cloud: configurar em Supabase Dashboard -> Authentication -> Providers.
# Local: adicionar [auth.external.google] em supabase/config.toml + supabase/.env.
