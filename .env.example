# Copy to .env.local and fill in. .env.local is git-ignored.
# Local values come from `supabase status` after `supabase start`.

# --- Supabase (required) ---
# API URL. Local: http://127.0.0.1:54321 | Cloud: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / publishable key (Project Settings -> API, or `supabase status`)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# JWT secret — used by src/lib/get-user-role.ts to verify the access token
# (Project Settings -> API -> JWT Settings, or `supabase status`)
SUPABASE_JWT_SECRET=

# --- App (optional) ---
# Shown on the login screen; defaults to "Amigo do Bolso"
NEXT_PUBLIC_APP_NAME=Amigo do Bolso

# --- Google OAuth (only for local Supabase; cloud is configured in the dashboard) ---
# Read by supabase/config.toml via env(). Also works from supabase/.env
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
